---
// 404 에러 페이지 - 페이지를 찾을 수 없음
// 404エラーページ - ページが見つかりません

import Layout from "../layouts/Layout.astro";

/**
 * 404 Not Found 페이지
 * 404 Not Foundページ
 *
 * CloudFront 에러 응답 시 S3에서 서빙되는 정적 에러 페이지
 * CloudFrontエラー応答時にS3からサービングされる静的エラーページ
 *
 * 디자인 포인트:
 * - 모바일: 레드 그라데이션 배경 + 이미지 오버레이
 * - 데스크톱: 전체 화면 이미지 + 왼쪽 텍스트
 * - 세로 화면: 이미지 전체 표시 (object-contain)
 *
 * デザインポイント:
 * - モバイル: レッドグラデーション背景 + 画像オーバーレイ
 * - デスクトップ: フルスクリーン画像 + 左テキスト
 * - 縦画面: 画像全体表示（object-contain）
 */

// ============================================================
// 공통 텍스트 및 URL 정의 (유지보수 용이성을 위해 중앙 집중화)
// 共通テキストとURL定義（メンテナンス性向上のため集中管理）
// ============================================================
const content = {
  // 에러 정보 / エラー情報
  errorCode: "404",
  title: "Page Not Found",

  // 메시지 (일본어) / メッセージ（日本語）
  messageJa: "お探しのページは見つかりませんでした。",
  messageJaDetail: "ページが移動または削除された可能性があります。",

  // 메시지 (영어) / メッセージ（英語）
  messageEn: "The page you're looking for doesn't exist or has been moved.",

  // CTA 텍스트 / CTAテキスト
  ctaHome: "ホームへ戻る",
  ctaProfile: "プロフィール",
  ctaOr: "または",
  ctaSuffix: "をご覧ください。",

  // URL (커스텀 도메인 적용 시 여기만 수정)
  // URL（カスタムドメイン適用時はここだけ修正）
  homeUrl: "https://d2opqv3ja0x6v5.cloudfront.net/",
  profileUrl: "https://d2opqv3ja0x6v5.cloudfront.net/#about",

  // 에셋 경로 / アセットパス
  modelImage: "/assets/bizreach-404-model-grok.png",
};

// 모바일용 줄바꿈 메시지 (화면이 좁아서 줄바꿈 필요)
// モバイル用改行メッセージ（画面が狭いため改行必要）
const mobileMessageLines = content.messageJa.replace("は", "は\n").split("\n");
---

<Layout title="転職ならビズリーチ｜選ばれた人だけのハイクラス転職サイト">
  <!-- Mobile Layout / モバイルレイアウト -->
  <div class="md:hidden relative flex flex-col bg-slate-950">
    <!-- Background Image Section / 背景画像セクション -->
    <div class="relative min-h-[50vh]">
      <img
        src={content.modelImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-[70%_25%]"
      />
      <!-- Gradient Overlay / グラデーションオーバーレイ -->
      <div class="absolute inset-0 bg-gradient-to-r from-red-900/90 via-red-900/60 to-transparent"></div>

      <!-- Mobile Text Content / モバイルテキストコンテンツ -->
      <div class="relative flex flex-col justify-center px-6 py-8 z-10 w-[65%] min-h-[50vh]">
        <span class="text-7xl font-bold tracking-tight bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent animate-fade-in">
          {content.errorCode}
        </span>
        <h1 class="mt-2 text-xl font-bold text-white animate-fade-in-up" style="animation-delay: 0.2s;">
          {content.title}
        </h1>
        <p class="mt-3 text-sm text-slate-200 leading-relaxed animate-fade-in-up" style="animation-delay: 0.3s;">
          {mobileMessageLines[0]}<br />{mobileMessageLines[1]}
        </p>
      </div>
    </div>

    <!-- Mobile CTA Section / モバイルCTAセクション -->
    <div class="bg-white px-6 py-6">
      <a
        href={content.homeUrl}
        class="flex items-center justify-center w-full py-4 bg-red-600 text-white font-bold text-lg rounded-xl hover:bg-red-700 transition-colors animate-fade-in-up"
        style="animation-delay: 0.4s;"
      >
        {content.ctaHome}
      </a>
      <p class="mt-4 text-center text-sm text-slate-500 animate-fade-in-up" style="animation-delay: 0.5s;">
        {content.ctaOr}
        <a href={content.profileUrl} class="text-red-600 hover:underline">{content.ctaProfile}</a>
        {content.ctaSuffix}
      </p>
    </div>
  </div>

  <!-- Desktop Layout / デスクトップレイアウト -->
  <div class="hidden md:flex relative min-h-screen items-center overflow-hidden bg-slate-950">
    <!-- Background Image / 背景画像 -->
    <div class="absolute inset-0">
      <img
        src={content.modelImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover object-center portrait:object-[70%_center]"
      />
      <!-- Left Gradient Overlay / 左側グラデーションオーバーレイ -->
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/80 via-slate-950/50 to-transparent"></div>
      <!-- Bottom Gradient / 下部グラデーション -->
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
      <!-- Noise Texture / ノイズテクスチャ -->
      <div
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E&quot;);"
      ></div>
    </div>

    <!-- Desktop Text Content / デスクトップテキストコンテンツ -->
    <div class="relative z-10 max-w-xl ml-16 lg:ml-24 px-6">
      <!-- 404 Number / 404番号 -->
      <div class="animate-fade-in">
        <span class="text-9xl lg:text-[10rem] font-bold tracking-tight bg-gradient-to-r from-red-500 via-red-400 to-red-600 bg-clip-text text-transparent drop-shadow-2xl">
          {content.errorCode}
        </span>
      </div>

      <!-- Error Message / エラーメッセージ -->
      <div class="animate-fade-in-up" style="animation-delay: 0.2s;">
        <h1 class="mt-2 text-3xl font-bold text-white">
          {content.title}
        </h1>
        <p class="mt-4 text-lg text-slate-300 leading-relaxed">
          {content.messageJa}<br />
          {content.messageJaDetail}
        </p>
        <p class="mt-2 text-sm text-slate-400">
          {content.messageEn}
        </p>
      </div>

      <!-- CTA Button / CTAボタン -->
      <div class="mt-8 animate-fade-in-up" style="animation-delay: 0.4s;">
        <a
          href={content.homeUrl}
          class="group relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold rounded-xl overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-red-500/30 hover:-translate-y-1"
        >
          <span class="relative z-10">{content.ctaHome}</span>
          <div class="absolute inset-0 bg-gradient-to-r from-red-500 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </a>
      </div>

      <!-- Additional Link / 追加リンク -->
      <div class="mt-6 animate-fade-in-up" style="animation-delay: 0.6s;">
        <p class="text-sm text-slate-400">
          {content.ctaOr}
          <a href={content.profileUrl} class="text-red-400 hover:text-red-300 underline underline-offset-4 transition-colors">
            {content.ctaProfile}
          </a>
          {content.ctaSuffix}
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* Fade-in Animation / フェードインアニメーション */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.8s ease-out forwards;
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out forwards;
  }
</style>
